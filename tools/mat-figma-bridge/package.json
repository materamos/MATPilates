{
  "name": "@mat-pilates/figma-local-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mat-figma-bridge": "dist/server/index.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.plugin-main.json && tsc -p tsconfig.plugin-ui.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/server/index.js",
    "reset-pairing": "node dist/server/index.js --reset-pairing"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.131.0",
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
